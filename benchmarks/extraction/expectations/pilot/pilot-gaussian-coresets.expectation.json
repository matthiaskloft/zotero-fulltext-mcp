      "equation": {
        "latex": "|\\mathcal{L}(\\mathcal{X} \\mid \\theta) - \\mathcal{L}(\\mathcal{C} \\mid \\theta)| \\le \\varepsilon\\mathcal{L}(\\mathcal{X} \\mid \\theta).",
        "number": null,
        "display": true
