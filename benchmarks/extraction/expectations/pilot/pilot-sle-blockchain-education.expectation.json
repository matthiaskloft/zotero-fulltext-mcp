      "reading_order": 5,
      "bbox": {
        "x0": 116.64,
        "y0": 116.96,
        "x1": 470.3,
        "y1": 135.48
      },
      "text": "Bing Xu is a Master in the School of Educational Technology, Faculty of Education, Beijing Normal University. Her current research interest is smart learning environments and digital reading.",
      "text_sha256": "725b4e819987f42576af31bc2f7874bd07a40da8be8abd3fb9bb445e525d7abd"
    },
    {
