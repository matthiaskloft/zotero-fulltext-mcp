{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-fulltext-mcp.invalid/extraction/run.schema.json",
  "title": "Extraction evaluation run",
  "description": "One evaluation run: pinned configurations and inputs, one result per (configuration, input) pair with hashes, failures and costs kept visible, and metrics with pinned versions. Holds no ground truth and no extracted content, only hashes that point at observation/expectation records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "record_id", "started_at", "metric_versions", "configurations", "inputs", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "run"},
    "record_id": {"$ref": "common.schema.json#/$defs/id"},
    "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "finished_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "environment": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Free-form pinned environment facts (python, platform, lockfile hash)."
    },
    "metric_versions": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {"$ref": "common.schema.json#/$defs/nonblank"},
      "description": "Metric name to pinned version. Every metric reported in results must appear here."
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tool", "version", "options_sha256"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "tool": {"$ref": "common.schema.json#/$defs/nonblank"},
          "version": {"$ref": "common.schema.json#/$defs/nonblank"},
          "model": {"type": "string"},
          "options": {"type": "object"},
          "options_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pdf_sha256", "expectation_sha256"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "pdf_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "expectation_id": {"$ref": "common.schema.json#/$defs/id"},
          "expectation_sha256": {"$ref": "common.schema.json#/$defs/sha256", "description": "Hash of the reviewed expectation file scored against."},
          "physical_pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/page_number"}}
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["configuration_id", "input_id", "status"],
        "properties": {
          "configuration_id": {"$ref": "common.schema.json#/$defs/id"},
          "input_id": {"$ref": "common.schema.json#/$defs/id"},
          "status": {"enum": ["ok", "failed", "timeout", "missing_backend", "skipped"]},
          "output_sha256": {"$ref": "common.schema.json#/$defs/sha256", "description": "Hash of the observation file the configuration produced. Required for status ok."},
          "observation_id": {"$ref": "common.schema.json#/$defs/id"},
          "verdict": {"enum": ["passed", "failed", "incomplete"], "description": "Optional. Strict-mode verdict of the scorer for this result: 'incomplete' when expected items went unscored or no strict check ran, so a partial score cannot read as a pass."},
          "unscored_items": {"type": "integer", "minimum": 0, "description": "Optional. Number of expected items the scorer listed as not scored (truncated, uncertain or not comparable)."},
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "message"],
            "properties": {"kind": {"$ref": "common.schema.json#/$defs/nonblank"}, "message": {"type": "string"}},
            "description": "Required for every status other than ok."
          },
          "latency_seconds": {"type": "number", "minimum": 0},
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu_seconds": {"type": "number", "minimum": 0},
              "peak_memory_mb": {"type": "number", "minimum": 0},
              "gpu_seconds": {"type": "number", "minimum": 0},
              "cost_usd": {"type": "number", "minimum": 0}
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "mode", "value"],
              "properties": {
                "name": {"$ref": "common.schema.json#/$defs/nonblank"},
                "version": {"$ref": "common.schema.json#/$defs/nonblank"},
                "mode": {"enum": ["strict", "tolerant"], "description": "Strict and tolerant results are separate metrics and never merged."},
                "value": {"type": "number"},
                "n": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "ok"}}}, "then": {"required": ["output_sha256"], "not": {"required": ["error"]}}, "else": {"required": ["error"], "not": {"required": ["metrics"]}}}
        ]
      }
    }
  }
}
