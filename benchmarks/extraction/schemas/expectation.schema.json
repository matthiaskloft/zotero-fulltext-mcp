{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zotero-fulltext-mcp.invalid/extraction/expectation.schema.json",
  "title": "Reviewed extraction expectation",
  "description": "Ground truth for a PDF (or set of its pages), established by a human inspecting the page images. Automatic extractor output must be recorded as an observation instead; this schema has no field through which it can become ground truth, and record_kind and the review block are mandatory here and forbidden there.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "record_id", "document", "scope", "pages", "blocks", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "expectation"},
    "record_id": {"$ref": "common.schema.json#/$defs/id"},
    "document": {"$ref": "common.schema.json#/$defs/document"},
    "scope": {"$ref": "common.schema.json#/$defs/scope"},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/page"}},
    "blocks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/block"}},
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "markers"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "ordinal", "page", "raw", "doi"],
            "properties": {
              "id": {"$ref": "common.schema.json#/$defs/id"},
              "ordinal": {"type": "integer", "minimum": 1, "description": "Position of the entry within the printed reference list."},
              "page": {"$ref": "common.schema.json#/$defs/page_number"},
              "block_id": {"$ref": "common.schema.json#/$defs/id"},
              "raw": {"type": "string", "description": "Raw entry text exactly as printed."},
              "raw_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
              "fields": {"$ref": "common.schema.json#/$defs/reference_fields"},
              "doi": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status"],
                "description": "Printed DOI only. 'absent_in_source' (the entry prints none) is deliberately distinct from any extractor parse failure, which is an observation-side concept.",
                "properties": {
                  "status": {"enum": ["present", "absent_in_source", "not_assessed"]},
                  "value": {"type": "string", "pattern": "^10\\.\\S+$"}
                },
                "if": {"properties": {"status": {"const": "present"}}},
                "then": {"required": ["value"]},
                "else": {"not": {"required": ["value"]}}
              },
              "uncertainty": {"$ref": "common.schema.json#/$defs/uncertainty"}
            }
          }
        },
        "markers": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/marker"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review"],
      "properties": {
        "proposed_by": {"$ref": "common.schema.json#/$defs/tool_identity", "description": "Tool/model that proposed the starting draft, if any. Informational only."},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["draft", "reviewed"], "description": "Only 'reviewed' records are ground truth; scorers must skip drafts."},
            "reviewer": {"$ref": "common.schema.json#/$defs/nonblank", "description": "Opaque reviewer handle; use a pseudonymous id, not a personal name."},
            "reviewed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
            "basis": {"enum": ["page_image_inspection", "pdf_inspection"], "description": "What the human compared against. Extractor output alone is not a basis."}
          },
          "if": {"properties": {"status": {"const": "reviewed"}}},
          "then": {"required": ["reviewer", "reviewed_at", "basis"]}
        },
        "uncertainty": {"$ref": "common.schema.json#/$defs/uncertainty"}
      }
    }
  }
}
